<h1> Products </h1>
 <% @products.each do |product| %>
   <h2><%= link_to "#{product.title}", "/product/#{product.id}/product_details" %></h2> 
   <h2><%= "#{product.product_type.medium}/#{product.product_type.artstyle}"%></h2>
   <ul>
      <% if product.promotions.any? %>
        <% product.promotions.each do |promotion| %>
          <li><h2>Promotion: <%= promotion.promotion_description %></h2></li>
          <li><h2>Discount: <%= "#{promotion.discount_percent}%" %> </li>
        <% end %>
      <% end %>
   </ul>
 <% end %>