<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  
  <div>
    <%= form.label :first_name, style: "display: block" %>
    <%= form.text_field :first_name, class: 'form-control' %>
    <%= form.label :last_name, style: "display: block" %> 
    <%= form.text_field :last_name, class: 'form-control' %>
    <%= form.label :sex, style: "display: block" %> 
    <%= form.text_field :sex, class: 'form-control' %>
    <%= form.label :birthday, style: "display: block" %> 
    <%= form.text_field :birthday, class: 'form-control' %>
  </div>
  
  <div>
    <%= form.label :username, style: "display: block" %> 
    <%= form.text_field :username, class: 'form-control' %>
    <%= form.label :password, style: "display: block" %> 
    <%= form.text_field :password, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :email, style: "display: block" %> 
    <%= form.text_field :email, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :address, style: "display: block" %> 
    <%= form.text_field :address, class: 'form-control' %>
    <%= form.label :zipcode, style: "display: block" %> 
    <%= form.text_field :zipcode, class: 'form-control' %>
    <%= form.label :state, style: "display: block" %> 
    <%= form.text_field :state, class: 'form-control' %>
  </div>

  <div>
    <%= form.submit "Submit", class:"btn btn-secondary"%>
  </div>
<% end %>