<% if session[:role]== 'admin' %>
  <h2> Current Users </h2>

  <% @users.each do |user| %>
    <div class="card" style="width: 18rem;">   
      <div class="card-body">
        <h5 class="card-title"><%=link_to user.username, user %></h5>
        <h6 class="card-subtitle mb-2 text-muted"> <%= user.full_name%> </h6>
        <%= button_to "Delete Account", user, method: :delete, class:"btn btn-secondary" %>
      </div>
    </div>
  <% end %>

  <%= link_to "New user", new_user_path, class:"btn btn-secondary" %>
<% end %>