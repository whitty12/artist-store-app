<% if current_user== @user|| session[:role]== 'admin' %>
    <h1><%= "#{@user.full_name}" %></h1>

    <li><%=link_to "My Cart", cart_path %></li>
    <%= render @user %>

    <%= link_to "Edit this user", edit_user_path(@user) %>
<% end %>
    
<% if session[:role]== 'admin' %>
    <%= link_to "Return to previous user list", users_path %>
    <%= button_to "Delete this user", @user, method: :delete %>
<% end %>