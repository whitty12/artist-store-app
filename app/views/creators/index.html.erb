<h1> Our Artists</h1>

 <% @creators.each do |creator| %>
   <div class="card" style="width: 18rem;">   
      <div class="card-body">
         <h5 class="card-title"><%= link_to "#{creator.full_name}", creator %></h5>
      </div>
    </div>
 <% end %>


<% if session[:role]== 'admin' %>
  <%= link_to "New Artist", new_creator_path, class:"btn btn-secondary" %>
<% end %>