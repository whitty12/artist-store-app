<h1><%= "#{@creator.full_name}" %></h1>

<div class="btn-group" role="group">
<%= link_to "Our Artists", creators_path, class:"btn btn-secondary" %>
<% if session[:role]== 'admin' %>
    <%= link_to "Edit Artist", edit_creator_path(@creator), class:"btn btn-secondary" %>
    <%= link_to "Delete Artist", @creator, data: { "turbo-method": :delete }, class:"btn btn-secondary" %>
<% end %>
</div>