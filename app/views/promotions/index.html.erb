<h1> Active Promotions </h1>

 <% @promotions.each do |promotion| %>
  <div class="card" style="width: 18rem;">
    <div class="card-body">
      <h5 class="card-title"><%=link_to "#{promotion.promotion_description}", promotion %></h5>
    </div>
  </div>
 <% end %>

<% if session[:role]== 'admin' %>
  <%= link_to "New Promotion", new_promotion_path,  class:"btn btn-secondary" %>
<% end %>