<h2><%= "#{@promotion.promotion_description}" %></h2>
    <p> Discount: <%= "#{@promotion.discount_percent}%" %> </p>


<div class="btn-group" role="group">
    <%= link_to "Back", promotions_path,  class:"btn btn-secondary" %>
    <% if session[:role]== 'admin' %>
        <%= link_to "Edit Promotion", edit_promotion_path(@promotion),  class:"btn btn-secondary" %>
        <%= link_to "Delete Promotion", @promotion,  class:"btn btn-secondary", data: { "turbo-method": :delete } %>
    <% end %>
</div>