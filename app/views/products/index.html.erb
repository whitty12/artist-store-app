<%= notice %>
<h1> Products </h1>
 <% @products.each do |product| %>
   <div class="card" style="width: 18rem;">
   <img class="card-img-top" src="..." alt="Card image cap">
      <div class="card-body">
         <h5 class="card-title"><%= link_to "#{product.title}", product %></h5>
         <h6 class = "card-subtitle mb-2 text-muted"><%= "Medium: #{product.medium}"%></h6>
         <% if product.promotion.present? %>
            <h6 class = "card-subtitle mb-2 text-muted">Promotion: <%= "#{product.promotion.promotion_description} - #{product.promotion.discount_percent}% off" %></h6>
         <% end %>
         <p class="card-text"><%= product.description %></p>
      </div>
   </div>
 <% end %>

 <% if session[:role]== 'admin' %>
    <%= link_to "New Product", new_product_path, class: "btn btn-secondary"%>
 <% end %>