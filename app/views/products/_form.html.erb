<%= form_with(model: product) do |form| %>
  <% if product.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :creator_id, style: "display: block" %>
    <%= form.collection_select :creator_id, Creator.all, :id, :full_name %>
  </div>

  <div>
    <%= form.label :promotion_id, style: "display: block" %>
     <%= form.collection_select :promotion_id, Promotion.all, :id, :promotion_description, include_blank: 'None' %>
  </div>


  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>
  
  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :medium, style: "display: block" %>
    <%= form.text_field :medium, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :price, style: "display: block" %>
    <%= form.number_field :price, class: 'form-control', step: 0.01, min: 0  %>
  </div>

  <div>
    <%= form.label :available, style: "display: block" %>
    <%= form.check_box :available, class: 'form-check-input' %>
  </div>

  <div>
    <%= form.submit "Submit", class:"btn btn-secondary" %>
  </div>
<% end %>