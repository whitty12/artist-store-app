
<ul>
    <h2>Created by: <%= @product.creator.full_name %></h2>
    <h2>Description: <%= @product.description %></h2>
    <h2>Price: <%= @product.price %></h2>
    <h2>Medium: <%= @product.medium %></h2>
    <h2>Available: <%= @product.available %></h2>
    <% if product.promotion.present? %>
        <h2>Promotion: <%= product.promotion.promotion_description %> - <%= "#{product.promotion.discount_percent}% Discount" %></h2>
    <% end %>
</ul>