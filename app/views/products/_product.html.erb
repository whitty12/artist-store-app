
<ul class = "list-group">
    <li class= "list-group-item">Created by: <%= @product.creator.full_name %></li>
    <li class= "list-group-item">Description: <%= @product.description %></li>
    <li class= "list-group-item">Price: <%= @product.price %></li>
    <li class= "list-group-item">Medium: <%= @product.medium %></li>
    <% if @product.available == true %>
        <li class= "list-group-item">Available: Yes </li>
    <% elsif @product.available == false %>
        <li class= "list-group-item">Available: No </li>
    <% else %>
        <li class= "list-group-item">Available: No Information </li>
    <% end %>
    <% if product.promotion.present? %>
        <li class= "list-group-item"> Promotion: <%= "#{product.promotion.promotion_description} - #{product.promotion.discount_percent}% Discount" %></li>
    <% end %>
</ul>